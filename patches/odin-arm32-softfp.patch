+when ODIN_ARCH == .arm32 {
+	_urandom_bytes :: proc "contextless" (dst: []byte) {
+		SYS_openat :: uintptr(322)
+		SYS_read   :: uintptr(3)
+		SYS_close  :: uintptr(6)
+		AT_FDCWD   :: ~uintptr(99) // -100
+		O_CLOEXEC  :: uintptr(0o2000000)
+		ERR_EINTR  :: 4
+
+		path := cstring("/dev/urandom")
+		fd := int(intrinsics.syscall(SYS_openat, AT_FDCWD, uintptr(rawptr(path)), O_CLOEXEC))
+		for fd == -ERR_EINTR {
+			fd = int(intrinsics.syscall(SYS_openat, AT_FDCWD, uintptr(rawptr(path)), O_CLOEXEC))
+		}
+		if fd < 0 {
+			panic_contextless("base/runtime: /dev/urandom unavailable")
+		}
+		defer _ = intrinsics.syscall(SYS_close, uintptr(fd))
+
+		dst := dst
+		for len(dst) > 0 {
+			n := int(intrinsics.syscall(SYS_read, uintptr(fd), uintptr(raw_data(dst)), uintptr(len(dst))))
+			if n == -ERR_EINTR {
+				continue
+			}
+			if n <= 0 {
+				panic_contextless("base/runtime: /dev/urandom read failed")
+			}
+			dst = dst[n:]
+		}
+	}
+}
